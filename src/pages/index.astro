---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'

const projects = await getCollection('projects')
---

<BaseLayout>
  <div class="home">
    <header class="home__header">
      <h1>Wesley Klein</h1>
    </header>

    <section class="home__intro" aria-label="Introduction">
      <p>I live in the Bay Area, with my wife and daughter.</p>
      <p>
        My background is in mathematics and software engineering, but my interests tend to wander.
        I like making things, understanding how things work, and finding interesting ways to bring
        ideas into the physical world.
      </p>
      <p>I use this space to share things I'm working on and ideas I'm exploring.</p>
      <p>
        You can find me on <a href="https://www.instagram.com/ofidlebits/" target="_blank" rel="noopener noreferrer">Instagram</a>, or reach me via <a href="mailto:wes@wesklein.com">email</a>.
      </p>
    </section>

    <section class="home__projects" aria-label="Projects">
      <div class="home__subheader">
        <h2>Projects</h2>
      </div>
      <ul>
        {projects.map(p => (
          <li>
            <a class="project" href={`/${p.id}`}>
              <span class="project__title">{p.data.title}</span>
              <span class="project__summary">{p.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  h1,
  h2 {
    all: unset;
    font-weight: 500;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .home {
    width: min(var(--page-width-medium), 100%);
    margin-left: auto;
    margin-right: auto;
  }

  .home__header {
    margin-bottom: var(--margin-small);
  }

  .home__subheader {
    /* Item padding adds 0.5rem above the first project */
    margin-bottom: calc(var(--margin-small) - 0.5rem);
  }

  .home__intro {
    margin-bottom: var(--margin-large);
  }

  .home__intro p + p {
    margin-top: var(--margin-small);
  }

  /* The whole item is the link. Negative side margins keep the text aligned
     with the rest of the page; the padding only shows as the hover background. */
  .home__projects ul {
    margin: 0 -0.75rem;
  }

  .project {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 0.15s ease-out;
  }

  .project:hover,
  .project:focus-visible {
    opacity: 1;
    background-color: var(--color-hover);
  }

  .project__title,
  .project__summary {
    display: block;
  }

  .project__summary {
    color: var(--color-text-secondary);
  }
</style>
