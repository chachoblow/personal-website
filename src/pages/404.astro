---
import BaseLayout from '../layouts/BaseLayout.astro'
import BackLink from '../components/BackLink.astro'
---

<BaseLayout title="Not found — Wesley Klein" noindex>
  <link
    slot="head"
    rel="preload"
    href="/fonts/Gambetta-Italic.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <div class="not-found">
    <p>Page not found.</p>
    <BackLink />
  </div>
</BaseLayout>

<style>
  .not-found {
    width: min(var(--page-width-medium), 100%);
    margin-left: auto;
    margin-right: auto;
  }

  .not-found p {
    margin-bottom: var(--margin-small);
  }
</style>
