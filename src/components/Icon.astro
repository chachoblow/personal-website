---
import type { IconName } from './icons'

interface Props {
  name: IconName
  size?: number
  'aria-hidden'?: string
  class?: string
}

const { name, size = 16, 'aria-hidden': ariaHidden, class: className } = Astro.props

// Phosphor icons, regular weight — viewBox 0 0 256 256, fill="currentColor"
const paths: Record<IconName, string> = {
  'arrow-u-up-left': '<path d="M232,144a64.07,64.07,0,0,1-64,64H80a8,8,0,0,1,0-16h88a48,48,0,0,0,0-96H51.31l34.35,34.34a8,8,0,0,1-11.32,11.32l-48-48a8,8,0,0,1,0-11.32l48-48A8,8,0,0,1,85.66,45.66L51.31,80H168A64.07,64.07,0,0,1,232,144Z"/>',
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  class={className}
  aria-hidden={ariaHidden}
  set:html={paths[name]}
/>
