---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import BackLink from '../components/BackLink.astro'
import ImageGroup from '../components/ImageGroup.astro'
import Lightbox from '../components/Lightbox.astro'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)
---

<BaseLayout title={`${entry.data.title} — Wesley Klein`} description={entry.data.summary}>
  <div class="project-view">
    <nav aria-label="Breadcrumb">
      <BackLink />
    </nav>

    <header>
      <h1>{entry.data.title}</h1>
    </header>

    <div class="content">
      <Content components={{ ImageGroup }} />
    </div>
  </div>
  <Lightbox />
</BaseLayout>

<style>
  h1 {
    all: unset;
    font-weight: 500;
  }

  p {
    margin: 0;
  }

  .project-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-small);
  }

  .project-view > * {
    width: min(var(--page-width-medium), 100%);
  }

  nav {
    margin-bottom: calc(var(--margin-medium) - var(--margin-small));
  }

  .project-view > .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-small);
    width: min(var(--page-width-medium), 100%);
  }

  .project-view > .content :global(p),
  .project-view > .content :global(ul) {
    width: min(var(--page-width-medium), 100%);
    margin: 0;
  }

  .project-view > .content :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
  }
</style>
