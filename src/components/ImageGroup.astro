---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/projects/**/*",
);

// Inline images are at most the text column wide (550px); 2x for retina.
const INLINE_WIDTHS = [550, 1100];
// Full-screen version: big enough for a large display, never upscaled.
const FULL_WIDTH = 2400;

const resolvedImages = await Promise.all(
  images.map(async ({ src, alt }) => {
    const key = `/src/assets${src}`;
    const loader = allImages[key];
    if (!loader) throw new Error(`ImageGroup: image not found at ${key}`);
    const meta = (await loader()).default;
    const full = await getImage({
      src: meta,
      width: Math.min(meta.width, FULL_WIDTH),
    });
    return { src: meta, alt, full: full.src };
  }),
);
---

<div class="images">
  {
    resolvedImages.map((img) => (
      <a class="zoom" href={img.full} aria-label={`View full screen: ${img.alt}`}>
        <Image
          src={img.src}
          alt={img.alt}
          widths={INLINE_WIDTHS.filter((w) => w <= img.src.width)}
          sizes="(max-width: 550px) 100vw, 550px"
          loading="lazy"
        />
      </a>
    ))
  }
</div>

<script>
  // Open images full screen in a modal; without JS the link opens the image itself.
  let dialog: HTMLDialogElement | undefined;

  function getDialog() {
    if (dialog) return dialog;
    dialog = document.createElement("dialog");
    dialog.className = "lightbox";
    dialog.innerHTML = "<img alt='' />";
    dialog.addEventListener("click", () => dialog!.close());
    document.body.append(dialog);
    return dialog;
  }

  document.addEventListener("click", (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>("a.zoom");
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey) return;
    event.preventDefault();
    const d = getDialog();
    const img = d.querySelector("img")!;
    const thumb = link.querySelector("img");
    // Show the already-loaded inline image while the full one loads.
    img.src = thumb?.currentSrc || "";
    img.alt = thumb?.alt || "";
    const full = new Image();
    full.onload = () => {
      if (d.open) img.src = full.src;
    };
    full.src = link.href;
    d.showModal();
  });
</script>

<style>
  .images {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--gap-medium);
    row-gap: var(--margin-small);
    align-items: flex-start;
    justify-content: center;
    width: min(var(--page-width-medium), 100%);
    margin-left: auto;
    margin-right: auto;
    margin-block: calc(var(--margin-medium) - var(--margin-small));
  }

  /* Margins don't collapse in the flex-column content, so back-to-back groups
     would get both margins plus the gap. Drop both, leaving only the content
     gap, which equals the row gap between images, so they read as one group. */
  .images:has(+ .images) {
    margin-bottom: 0;
  }

  .images + .images {
    margin-top: 0;
  }

  /* With no text above, start where text would, right under the title. */
  .images:first-child {
    margin-top: 0;
  }

  .zoom {
    display: block;
    max-width: 100%;
    cursor: zoom-in;
  }

  .zoom:hover {
    opacity: 1;
  }

  .images img {
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 70vh;
    object-fit: contain;
    display: block;
  }

  :global(.lightbox) {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    padding: var(--margin-small);
    border: 0;
    background: var(--color-background);
    cursor: zoom-out;
  }

  :global(.lightbox[open]) {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.lightbox)::backdrop {
    background: var(--color-background);
  }

  :global(.lightbox img) {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  :global(html:has(.lightbox[open])) {
    overflow: hidden;
  }
</style>
