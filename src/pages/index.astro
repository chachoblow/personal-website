---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import Icon from '../components/Icon.astro'
import type { IconName } from '../components/icons'

const projects = await getCollection('projects')

const disciplineIconMap: Record<string, IconName> = {
  software: 'laptop',
  object: 'sphere',
  sound: 'wave-sine',
  image: 'rectangle',
  print: 'book',
}
---

<BaseLayout>
  <div class="home">
    <header class="home__header">
      <h1>Wesley Klein</h1>
    </header>

    <section class="home__intro" aria-label="Introduction">
      <p>I live in the Bay Area, with my wife and daughter.</p>
      <p>
        My background is in mathematics and software engineering, but my interests tend to wander.
        I like making things, understanding how things work, and finding interesting ways to bring
        ideas into the physical world.
      </p>
      <p>I use this space to share things I'm working on and ideas I'm exploring.</p>
      <p>
        You can find me on <a href="https://www.instagram.com/ofidlebits/" target="_blank" rel="noopener noreferrer">Instagram</a>, or reach me via <a href="mailto:wes@wesklein.com">email</a>.
      </p>
    </section>

    <section class="home__projects" aria-label="Projects">
      <div class="home__subheader">
        <h2>Projects</h2>
      </div>
      <ul>
        {projects.map(p => (
          <li class="project">
            <div class="project__title">
              <a href={`/${p.id}`}>{p.data.title}</a>
              {p.data.disciplines.map(d => (
                <Icon
                  name={disciplineIconMap[d]}
                  size={16}
                  aria-hidden="true"
                  class="icon"
                />
              ))}
            </div>
            <p class="project__summary">{p.data.summary}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  h1,
  h2 {
    all: unset;
    font-weight: 500;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .icon {
    vertical-align: middle;
  }

  .home {
    width: min(var(--page-width-medium), 100%);
    margin-left: auto;
    margin-right: auto;
  }

  .home__header {
    margin-bottom: var(--margin-small);
  }

  .home__subheader {
    margin-bottom: var(--margin-small);
  }

  .home__intro {
    margin-bottom: var(--margin-large);
  }

  .home__intro p + p {
    margin-top: var(--margin-small);
  }
  .project + .project {
    margin-top: var(--margin-small);
  }

  .project__title {
    display: flex;
    align-items: center;
    gap: var(--gap-medium);
  }
</style>
