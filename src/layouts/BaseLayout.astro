---
import { getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
  /** Shown when the page is shared as a link */
  image?: ImageMetadata
  imageAlt?: string
  /** Keep the page out of search results (and give it no canonical URL) */
  noindex?: boolean
}

const { title = 'Wesley Klein', description, image, imageAlt, noindex = false } = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
// JPEG, which every link preview supports
const preview = image && (await getImage({ src: image, width: 1200, format: 'jpg' }))
const previewUrl = preview && new URL(preview.src, Astro.site)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/GeneralSans-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Medium is the page title -->
    <link rel="preload" href="/fonts/GeneralSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <slot name="head" />
    <!-- Match the browser's bars to the page background (see global.css) -->
    <meta name="theme-color" content="#fff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a1a" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Wesley Klein" />
    <meta property="og:title" content={title} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {description && <meta property="og:description" content={description} />}
    {previewUrl && <meta property="og:image" content={previewUrl} />}
    {preview && <meta property="og:image:width" content={String(preview.attributes.width)} />}
    {preview && <meta property="og:image:height" content={String(preview.attributes.height)} />}
    {previewUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta name="twitter:card" content={previewUrl ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  /* No side padding needed: wider than 768px, the 550px column has room */
  main {
    padding-block: 5rem 2.5rem;
  }

  @media (max-width: 768px) {
    main {
      padding: 2rem 1.5rem 2.5rem;
    }
  }
</style>
