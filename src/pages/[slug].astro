---
import { getCollection, render } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import BackLink from '../components/BackLink.astro'
import ImageGroup from '../components/ImageGroup.astro'
import Lightbox from '../components/Lightbox.astro'
import { previewImage } from '../lib/previewImage'

export async function getStaticPaths() {
  const projects = await getCollection('projects')
  return projects.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }))
}

const { entry } = Astro.props
const { Content } = await render(entry)

const preview = await previewImage(entry)
---

<BaseLayout
  title={`${entry.data.title} — Wesley Klein`}
  description={entry.data.summary}
  image={preview?.image}
  imageAlt={preview?.alt}
>
  <!-- "Home" in BackLink is in view on load -->
  <link
    slot="head"
    rel="preload"
    href="/fonts/Gambetta-Italic.woff2"
    as="font"
    type="font/woff2"
    crossorigin
  />
  <!-- Lets ImageGroup hide lazy images until they load (set before the body
       renders, so no image is shown and then hidden). imageLoaded is their
       onload: one that arrives with the page (cached or fast) just appears,
       and only a late one fades in, since only then was there a gap to cover. -->
  <script slot="head" is:inline>
    document.documentElement.classList.add('js')
    window.imageLoaded = img => {
      if (performance.now() > 200) img.classList.add('fade-in')
      img.classList.add('is-loaded')
    }
  </script>
  <div class="project-view">
    <nav>
      <BackLink />
    </nav>

    <header>
      <h1>{entry.data.title}</h1>
    </header>

    <div class="content">
      <Content components={{ ImageGroup }} />
    </div>
  </div>
  <Lightbox />
</BaseLayout>

<style>
  h1 {
    all: unset;
    font-weight: 500;
  }

  .project-view {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-small);
  }

  .project-view > * {
    width: min(var(--page-width-medium), 100%);
  }

  nav {
    margin-bottom: calc(var(--margin-medium) - var(--margin-small));
  }

  .project-view > .content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--margin-small);
  }

  .project-view > .content :global(p),
  .project-view > .content :global(ul) {
    /* The column centers its children, so give text the full width */
    width: min(var(--page-width-medium), 100%);
  }

  .project-view > .content :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
  }
</style>
