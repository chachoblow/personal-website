---
import { Image, getImage } from 'astro:assets'
import { INLINE_WIDTH, SIZES, imageSize, inlineImage, loadImage, stillPath } from '../lib/images'

interface Props {
  images: { src: string; alt: string }[]
}

const { images } = Astro.props

// The first group's first image is usually in view on load, so it's fetched
// right away instead of lazily. Claimed before any await, so groups claim it
// in page order.
const isFirstGroup = !Astro.locals.imageGroupRendered
Astro.locals.imageGroupRendered = true

// Full-screen version: big enough for a large display, never upscaled.
const FULL_WIDTH = 2400
// Smaller full-screen sizes, so smaller screens load less. Lightbox picks one
// for the screen; 1100 is the inline 2x size, so it's already built.
const FULL_WIDTHS = [1100, 1600]

const resolvedImages = await Promise.all(
  images.map(async ({ src, alt }, index) => {
    const meta = await loadImage(src)
    if (!meta) throw new Error(`ImageGroup: image not found at /src/assets${src}`)
    const { width, height } = imageSize(meta)
    const fullWidth = Math.min(width, FULL_WIDTH)
    const fullHeight = Math.round((height * fullWidth) / width)
    const fullWidths = [...FULL_WIDTHS.filter(w => w < fullWidth), fullWidth]
    const full = await getImage({ src: meta, width: fullWidth, widths: fullWidths })

    // An animated GIF can have a still frame next to it, `<name>-still.webp`,
    // shown instead to people who ask their system to reduce motion.
    const still = src.endsWith('.gif') ? await loadImage(stillPath(src)) : undefined
    const stillInline = still ? await getImage(inlineImage(still)) : undefined
    const stillFull = still
      ? await getImage({ src: still, width: fullWidth, widths: fullWidths })
      : undefined

    const eager = isFirstGroup && index === 0
    return {
      alt,
      // The link's size on the page, set before the image loads so its space
      // is reserved instead of opening up when it arrives (see .zoom below)
      style: `--width: ${Math.min(width, INLINE_WIDTH)}px; --ratio: ${width / height}`,
      full: full.src,
      fullSrcset: full.srcSet.attribute,
      fullWidth,
      fullHeight,
      stillSrcset: stillInline?.srcSet.attribute,
      stillFullSrcset: stillFull?.srcSet.attribute,
      image: {
        ...inlineImage(meta),
        alt,
        loading: eager ? 'eager' : 'lazy',
        fetchpriority: eager ? 'high' : undefined,
        // Lazy images that load late fade in instead of popping in (see
        // imageLoaded in [slug].astro, and the styles). The eager one shows at
        // once, so the page isn't slower to appear. An inline handler is in
        // place before the image can load, so none finishes unnoticed.
        class: eager ? undefined : 'fade',
        onload: eager ? undefined : 'imageLoaded(this)',
        onerror: eager ? undefined : 'imageLoaded(this)',
      } as const,
    }
  }),
)
---

<div class="images">
  {resolvedImages.map(img => (
    <a
      class="zoom"
      style={img.style}
      href={img.full}
      data-srcset={img.fullSrcset}
      data-width={img.fullWidth}
      data-height={img.fullHeight}
      data-still-srcset={img.stillFullSrcset}
      aria-label={`View full screen: ${img.alt}`}
    >
      {img.stillSrcset ? (
        <picture>
          <source media="(prefers-reduced-motion: reduce)" srcset={img.stillSrcset} sizes={SIZES} />
          <Image {...img.image} />
        </picture>
      ) : (
        <Image {...img.image} />
      )}
    </a>
  ))}
</div>

<style>
  .images {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--gap-medium);
    row-gap: var(--margin-small);
    align-items: flex-start;
    justify-content: center;
    width: min(var(--page-width-medium), 100%);
    margin-left: auto;
    margin-right: auto;
    margin-block: calc(var(--margin-medium) - var(--margin-small));
  }

  /* Margins don't collapse in the flex-column content, so back-to-back groups
     would get both margins plus the gap. Drop both, leaving only the content
     gap, which equals the row gap between images, so they read as one group. */
  .images:has(+ .images) {
    margin-bottom: 0;
  }

  .images + .images {
    margin-top: 0;
  }

  /* With no text above, start where text would, right under the title. */
  .images:first-child {
    margin-top: 0;
  }

  /* The size the image will show at: the column, its own width, or as wide as
     fits 70vh tall, whichever is smallest. Set on the link rather than left to
     the image, which has no size until it loads (its width/height attributes
     only give it a ratio), so the page would grow as images arrive. */
  .zoom {
    display: block;
    width: min(100%, var(--width), 70vh * var(--ratio));
    cursor: default;
  }

  /* Set by Lightbox only when full screen would be noticeably larger */
  .zoom.is-zoomable {
    cursor: zoom-in;
  }

  .zoom:hover {
    opacity: 1;
  }

  .images picture {
    display: contents;
  }

  /* Fills the link; the width/height attributes give the height before load */
  .images img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Hidden until loaded only when JS is running (the project page's head sets
     .js), so without it, images show as usual. An animation, not a transition,
     so an image can only ever fade in, once. With reduced motion, images
     appear at once. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .images img.fade:not(.is-loaded) {
      opacity: 0;
    }

    .images img.fade-in {
      animation: fade-in 0.3s ease-out;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>
