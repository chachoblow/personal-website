---
import { getCollection } from 'astro:content'
import { getImage } from 'astro:assets'
import BaseLayout from '../layouts/BaseLayout.astro'
import { previewImage } from '../lib/previewImage'
import { SIZES, inlineImage, loadImage, projectImages, stillPath } from '../lib/images'

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order)
// The link preview shows the top project's preview image
const preview = projects[0] && (await previewImage(projects[0]))

// Each project's first images, roughly what's in view when it opens. The page
// fetches them once it has loaded, so a project opens fully drawn and the
// crossfade runs between two finished pages. About 360 KB for all projects.
const PRELOAD_PER_PROJECT = 3
const preloads = await Promise.all(
  projects.flatMap(project =>
    projectImages(project)
      .slice(0, PRELOAD_PER_PROJECT)
      .map(async ({ src }) => {
        const image = src && (await loadImage(src))
        if (!image) return undefined
        const still = src.endsWith('.gif') ? await loadImage(stillPath(src)) : undefined
        return {
          srcset: (await getImage(inlineImage(image))).srcSet.attribute,
          stillSrcset: still && (await getImage(inlineImage(still))).srcSet.attribute,
        }
      }),
  ),
)
const images = preloads.filter(Boolean)
---

<BaseLayout
  description="Wesley Klein's projects and ideas: software, objects, sound, images and print."
  image={preview?.image}
  imageAlt={preview?.alt}
>
  <div class="home">
    <header class="home__header">
      <h1>Wesley Klein</h1>
    </header>

    <section class="home__intro" aria-label="Introduction">
      <p>I live in the Bay Area, with my wife, daughter and dog.</p>
      <p>
        My background is in mathematics and software engineering, but my interests tend to wander. I
        like making things, understanding how things work, and finding interesting ways to bring
        ideas into the physical world.
      </p>
      <p>I use this space to share things I'm working on and ideas I'm exploring.</p>
      <!-- prettier-ignore -->
      <p>
        You can find me on <a href="https://www.instagram.com/ofidlebits/" target="_blank" rel="noopener noreferrer">Instagram<span class="visually-hidden"> (opens in a new tab)</span></a>, or reach me via <a href="mailto:wes@wesklein.com">email</a>.
      </p>
    </section>

    <section class="home__projects" aria-label="Projects">
      <div class="home__subheader">
        <h2>Projects</h2>
      </div>
      <ul>
        {projects.map(p => (
          <li>
            <a class="project" href={`/${p.id}/`}>
              <span class="project__title">{p.data.title}</span>
              <span class="project__summary">{p.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
  <script is:inline define:vars={{ images, sizes: SIZES }}>
    // Fetch each project's first images once this page is done and the browser
    // is idle, skipped if the visitor asked to save data. Same srcset and sizes
    // as on the project page, so the browser picks the same file and it's a
    // cache hit there. (Safari has no requestIdleCallback; it waits a moment.)
    window.preloadedImages = []
    addEventListener('load', () => {
      ;(window.requestIdleCallback ?? (run => setTimeout(run, 200)))(() => {
        if (navigator.connection?.saveData) return
        const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
        for (const { srcset, stillSrcset } of images) {
          const img = new Image()
          img.fetchPriority = 'low'
          img.sizes = sizes
          img.srcset = (reduceMotion && stillSrcset) || srcset
          // Kept, so the browser doesn't drop a download in progress
          window.preloadedImages.push(img)
        }
      })
    })
  </script>
</BaseLayout>

<style>
  h1,
  h2 {
    all: unset;
    font-weight: 500;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .home {
    width: min(var(--page-width-medium), 100%);
    margin-left: auto;
    margin-right: auto;
  }

  .home__header {
    margin-bottom: var(--margin-small);
  }

  .home__subheader {
    /* Item padding adds 0.5rem above the first project */
    margin-bottom: calc(var(--margin-small) - 0.5rem);
  }

  .home__intro {
    margin-bottom: var(--margin-large);
  }

  .home__intro p + p {
    margin-top: var(--margin-small);
  }

  /* The whole item is the link. Negative side margins keep the text aligned
     with the rest of the page; the padding only shows as the hover background. */
  .home__projects ul {
    margin: 0 -0.75rem;
  }

  .project {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: background-color 0.15s ease-out;
  }

  .project:focus-visible {
    background-color: var(--color-hover);
  }

  /* Touch screens treat a tap as a brief hover, which flashes the background
     on the way out, so only show it where there's a real pointer. */
  @media (hover: hover) {
    .project:hover {
      opacity: 1;
      background-color: var(--color-hover);
    }
  }

  /* Without hover there's no background to hint the rows are links, so
     underline the titles like the site's other links. */
  @media not (hover: hover) {
    .project__title {
      text-decoration: underline;
      text-underline-offset: 2px;
    }
  }

  .project__title,
  .project__summary {
    display: block;
  }

  .project__summary {
    color: var(--color-text-secondary);
  }
</style>
